[Desktop Entry]
Type=Application
Terminal=false
Name=POPOPX Chat
Comment=A private & encrypted open-source messenger without any user IDs (not even random ones)!
Keywords=chat;message;private;secure;popopx;
Categories=Utility;Chat;InstantMessaging;
Exec=popopx %U
Icon=chat.popopx.popopx
StartupWMClass=popopx-chat
