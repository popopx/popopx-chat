{
  "name": "popopx-chat",
  "version": "7.0.4",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "src",
    "cpp",
    "dist",
    "binding.gyp",
    "tsconfig.json",
    "docs",
    "examples"
  ],
  "scripts": {
    "preinstall": "node src/download-libs.js",
    "install": "node-gyp configure; node-gyp rebuild --release",
    "install-tools": "npm install -g node-gyp",
    "configure": "node-gyp configure; mkdir libs 2> /dev/null || true",
    "build": "node-gyp rebuild && tsc && cp ./src/popopx.* ./dist",
    "run": "node src/index.js",
    "build-run": "node-gyp build && node src/index.js",
    "test": "jest",
    "docs": "typedoc"
  },
  "dependencies": {
    "@popopx-chat/types": "file:../popopx-chat-client/types/typescript",
    "fast-deep-equal": "^3.1.3",
    "node-addon-api": "^8.5.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.5",
    "@types/yauzl": "^3.4.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typedoc": "^0.28.15",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/popopx/popopx-chat.git"
  },
  "keywords": [
    "messenger",
    "chat",
    "privacy",
    "security"
  ],
  "author": "POPOPX Chat",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/popopx/popopx-chat/issues"
  },
  "homepage": "https://github.com/popopx/popopx-chat/tree/stable/packages/popopx-chat-nodejs#readme",
  "description": "POPOPX Chat Node.js library for chat bots"
}
