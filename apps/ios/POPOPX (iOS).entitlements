<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:popopx.chat</string>
		<string>applinks:www.popopx.chat</string>
		<string>applinks:popopx.chat?mode=developer</string>
		<string>applinks:*.popopxchat.com</string>
		<string>applinks:*.popopxchat.com?mode=developer</string>
		<string>applinks:*.popopchat.com</string>
		<string>applinks:*.popopchat.com?mode=developer</string>
		<string>applinks:*.popopx.xyz</string>
		<string>applinks:*.popopx.xyz?mode=developer</string>
		<string>applinks:*.popopxchat.xyz</string>
		<string>applinks:*.popopxchat.xyz?mode=developer</string>
		<string>applinks:*.popopchat.xyz</string>
		<string>applinks:*.popopchat.xyz?mode=developer</string>
		<string>applinks:*.popopx.cc</string>
		<string>applinks:*.popopx.cc?mode=developer</string>
		<string>applinks:*.parrotlink.xyz</string>
		<string>applinks:*.parrotlink.xyz?mode=developer</string>
	</array>
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.popopxchat.popopx</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.popopxchat.popopx</string>
	</array>
</dict>
</plist>
